<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>JobFlow.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>JobFlow Mobile</ApplicationTitle>
    <ApplicationId>com.tmassey1979.jobflowmobile</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon
      Include="Resources\AppIcon\appicon.svg"
      ForegroundFile="Resources\AppIcon\appiconfg.svg"
      ForegroundScale="0.65"
      Color="#1A1A1A" />
    <MauiSplashScreen
      Include="Resources\Splash\splash.svg"
      Color="#1A1A1A"
      BaseSize="128,128" />
    <MauiImage Include="Resources\Images\empty_jobs.svg" BaseSize="240,160" />
    <MauiImage Include="Resources\Images\signal_mark.svg" BaseSize="108,108" />
  </ItemGroup>
</Project>
