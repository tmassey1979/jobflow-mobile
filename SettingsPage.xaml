<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.SettingsPage"
             Title="Settings"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Settings" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
            <Label Text="Manage your cloud account and local data." FontSize="14" TextColor="{StaticResource MutedInk}" />
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="JobFlow Cloud" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label x:Name="CloudStatusLabel" FontSize="13" TextColor="{StaticResource MutedInk}" />
                    <Button Text="Open Cloud Account" Clicked="OnOpenIntegrationsClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#B9CBEA" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Master resume" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Import a .txt or .md file, or paste your resume below. It is saved only to your signed-in private JobFlow account and is never added to the shared jobs feed or source repository." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Label x:Name="MasterResumeStatusLabel" Text="Not loaded" FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Import file" Clicked="OnImportMasterResumeClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                        <Button Grid.Column="1" Text="Load from cloud" Clicked="OnLoadMasterResumeClicked" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />
                    </Grid>
                    <Editor x:Name="MasterResumeEditor" Placeholder="Paste your complete master resume here…" AutoSize="TextChanges" MinimumHeightRequest="220" TextColor="{StaticResource Ink}" />
                    <Button Text="Save master resume to private cloud" Clicked="OnSaveMasterResumeClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Local data" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label x:Name="LocalDataLabel" FontSize="13" TextColor="{StaticResource MutedInk}" />
                    <Button Text="Export applications (clipboard JSON)" Clicked="OnExportClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                    <Button Text="Clear cached job feed" Clicked="OnClearCacheClicked" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />
                    <Label Text="Exports contain application records only, never account credentials. Clearing the feed cache does not remove tracked applications." FontSize="11" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Border>
            <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>