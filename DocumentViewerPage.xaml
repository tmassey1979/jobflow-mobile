<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.DocumentViewerPage"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label x:Name="SubtitleLabel" FontSize="13" TextColor="{StaticResource MutedInk}" LineBreakMode="WordWrap" />
            <Label x:Name="PathLabel" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="MiddleTruncation" />
            <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource MutedInk}" IsVisible="False" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Stroke="#D9E0EB" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="14">
            <ScrollView>
                <Label x:Name="BodyLabel"
                       FontSize="14"
                       TextColor="{StaticResource Ink}"
                       LineBreakMode="WordWrap" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
