<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.DocumentViewerPage"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="2">
            <Label x:Name="SubtitleLabel" FontSize="13" TextColor="{StaticResource MutedInk}" LineBreakMode="WordWrap" />
            <Label x:Name="PathLabel" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="MiddleTruncation" />
            <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource MutedInk}" IsVisible="False" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button x:Name="ViewTabButton" Grid.Column="0" Text="View" Clicked="OnViewTabClicked" CornerRadius="8" Padding="8,6" FontSize="13" />
            <Button x:Name="EditTabButton" Grid.Column="1" Text="Edit" Clicked="OnEditTabClicked" CornerRadius="8" Padding="8,6" FontSize="13" />
        </Grid>

        <Border Grid.Row="2" Stroke="#D9E0EB" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="0">
            <Grid>
                <ScrollView x:Name="ViewScroll">
                    <Label x:Name="BodyLabel"
                           Margin="12"
                           FontSize="14"
                           TextColor="{StaticResource Ink}"
                           LineBreakMode="WordWrap" />
                </ScrollView>
                <Editor x:Name="BodyEditor"
                        IsVisible="False"
                        FontSize="14"
                        AutoSize="TextChanges"
                        TextColor="{StaticResource Ink}"
                        BackgroundColor="White"
                        Margin="8"
                        Placeholder="Markdown content…" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
