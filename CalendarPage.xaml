<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobFlow.Mobile.Models"
             x:Class="JobFlow.Mobile.CalendarPage"
             Title="Calendar"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">
        <VerticalStackLayout Spacing="6">
            <Label Text="Calendar" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
            <Label x:Name="StatusLabel"
                   Text="Local follow-ups and Google Calendar (read-only)."
                   FontSize="12"
                   TextColor="{StaticResource MutedInk}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="RefreshButton"
                        Grid.Column="0"
                        Text="Refresh"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="{StaticResource Accent}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="10,8"
                        FontSize="13" />
                <Button Grid.Column="1"
                        Text="Open tracker"
                        Clicked="OnOpenTrackerClicked"
                        BackgroundColor="#E9F0FF"
                        TextColor="{StaticResource Accent}"
                        CornerRadius="8"
                        Padding="10,8"
                        FontSize="13" />
            </Grid>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="EventsRefresh" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="EventsCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="10" VerticalOptions="Center">
                        <Label Text="Nothing on the calendar yet"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Set follow-up dates on Applications, or connect Google Calendar on Integrations (read-only)."
                               FontSize="13"
                               TextColor="{StaticResource MutedInk}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CalendarListItem">
                        <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8" BackgroundColor="White">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding WhenDisplay}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                    <Label Grid.Column="1" Text="{Binding Kind}" FontSize="11" TextColor="{StaticResource MutedInk}" />
                                </Grid>
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{StaticResource MutedInk}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" MaxLines="2" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
