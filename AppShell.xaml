<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="JobFlow.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JobFlow.Mobile"
    FlyoutBehavior="Disabled"
    Title="JobFlow">
    <TabBar>
        <ShellContent
            Title="Jobs"
            Route="jobs"
            ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent
            Title="Employers"
            Route="employers"
            ContentTemplate="{DataTemplate local:EmployersPage}" />
        <ShellContent
            Title="Applications"
            Route="applications"
            ContentTemplate="{DataTemplate local:ApplicationTrackerPage}" />
        <ShellContent
            Title="Calendar"
            Route="calendar"
            ContentTemplate="{DataTemplate local:CalendarPage}" />
        <ShellContent
            Title="Integrations"
            Route="integrations"
            ContentTemplate="{DataTemplate local:IntegrationsPage}" />
        <ShellContent
            Title="Settings"
            Route="settings"
            ContentTemplate="{DataTemplate local:SettingsPage}" />
    </TabBar>
</Shell>
