<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Signal Mark palette (issue #31): charcoal ink, electric blue accent -->
            <Color x:Key="PageBackground">#F5F7FB</Color>
            <Color x:Key="Ink">#1A1A1A</Color>
            <Color x:Key="MutedInk">#64748B</Color>
            <Color x:Key="Accent">#2563EB</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
