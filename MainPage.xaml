<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobFlow.Mobile.Models"
             x:Class="JobFlow.Mobile.MainPage"
             Title="JobFlow Mobile"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                <Image Grid.Column="0" Source="signal_mark.png" WidthRequest="36" HeightRequest="36" Aspect="AspectFit" VerticalOptions="Center" SemanticProperties.Description="JobFlow Signal Mark logo" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label Text="JobFlow" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label x:Name="ConnectionSummaryLabel" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Entry x:Name="SearchEntry" Grid.Column="0" Placeholder="Filter title or company" TextChanged="OnSearchTextChanged" ClearButtonVisibility="WhileEditing" FontSize="14" />
                <Button x:Name="SortButton" Grid.Column="1" Text="Sort" Clicked="OnSortClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" Padding="10,8" FontSize="13" />
                <Button x:Name="LoadButton" Grid.Column="2" Text="Sync" Clicked="OnLoadJobsClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="8" Padding="10,8" FontSize="13" />
            </Grid>

            <Label x:Name="StatusLabel" Text="Pull down to import every job from your data repo." FontSize="12" TextColor="{StaticResource MutedInk}" />
            <Label x:Name="FeedDateLabel" FontSize="11" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>

        <RefreshView x:Name="JobsRefresh" Grid.Row="1" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="JobsCollection" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="empty_jobs.png"
                               WidthRequest="160"
                               HeightRequest="106"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Illustration of a quiet signal with no jobs yet" />
                        <Label Text="No jobs imported yet" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                        <Label Text="Sign in on Integrations, choose your data repo, then pull down or tap Sync to import every daily feed." TextColor="{StaticResource MutedInk}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:JobListItem">
                        <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 10" Padding="10" Margin="0,0,0,6" BackgroundColor="White">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label Grid.Column="1" Text="{Binding TrackedLabel}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalOptions="Start" />
                                </Grid>
                                <Label Text="{Binding Company}" FontSize="13" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SalaryLabel}" FontSize="12" TextColor="{StaticResource Ink}" />
                                <Label Text="{Binding RemoteScope}" FontSize="11" TextColor="{StaticResource MutedInk}" LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="Details" Clicked="OnJobDetailsClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="6" Padding="6,6" FontSize="12" />
                                    <Button Grid.Column="1" Text="Track" Clicked="OnTrackApplicationClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="6" Padding="6,6" FontSize="12" />
                                    <Button Grid.Column="2" Text="Apply" Clicked="OnOpenApplicationClicked" CommandParameter="{Binding ApplicationUrl}" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="6" Padding="6,6" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
