<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JobFlow.Mobile.Models"
             x:Class="JobFlow.Mobile.MainPage"
             Title="JobFlow Mobile"
             BackgroundColor="{StaticResource PageBackground}">
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                <Image Grid.Column="0" Source="signal_mark.png" WidthRequest="44" HeightRequest="44" Aspect="AspectFit" VerticalOptions="Center" SemanticProperties.Description="JobFlow Signal Mark logo" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="JobFlow" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Your job search, in your pocket." FontSize="14" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Grid>
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="14" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Private job feed" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label x:Name="ConnectionSummaryLabel" Text="Sign in with GitHub on the Integrations tab, then choose your data repository." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Button x:Name="LoadButton" Text="Load latest jobs" Clicked="OnLoadJobsClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                    <Entry x:Name="SearchEntry" Placeholder="Filter by title or company" TextChanged="OnSearchTextChanged" ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>
            </Border>
            <Label x:Name="StatusLabel" Text="Sign in to load the latest verified feed." FontSize="13" TextColor="{StaticResource MutedInk}" />
            <Label x:Name="FeedDateLabel" FontSize="12" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>

        <CollectionView x:Name="JobsCollection" Grid.Row="1" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="empty_jobs.png"
                           WidthRequest="200"
                           HeightRequest="133"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           SemanticProperties.Description="Illustration of a quiet signal with no jobs yet" />
                    <Label Text="No jobs loaded yet" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
                    <Label Text="Sign in on Integrations, choose your data repo, then load the latest feed." TextColor="{StaticResource MutedInk}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JobFeedItem">
                    <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10" BackgroundColor="White">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding Company}" FontSize="14" TextColor="{StaticResource Accent}" />
                            <Label Text="{Binding SalaryLabel}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                            <Label Text="{Binding RemoteScope}" FontSize="12" TextColor="{StaticResource MutedInk}" />
                            <Label Text="{Binding MatchScore, StringFormat='Match score: {0}%'}" FontSize="12" TextColor="{StaticResource MutedInk}" />
                            <Button Text="Details" Clicked="OnJobDetailsClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="8" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="Resume" Clicked="OnViewResumeClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" />
                                <Button Grid.Column="1" Text="Cover letter" Clicked="OnViewCoverLetterClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" />
                            </Grid>
                            <Button Text="Track application" Clicked="OnTrackApplicationClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" />
                            <Button Text="Open application" Clicked="OnOpenApplicationClicked" CommandParameter="{Binding ApplicationUrl}" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
