<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.IntegrationsPage"
             Title="Integrations"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                <Image Grid.Column="0" Source="signal_mark.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" VerticalOptions="Center" SemanticProperties.Description="JobFlow Signal Mark logo" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Integrations" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Connect the services JobFlow can read." FontSize="13" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Connect Supabase for cloud sync, or use GitHub as the legacy feed source." FontSize="14" TextColor="{StaticResource MutedInk}" />

            <Border Stroke="#B9CBEA" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Supabase · Cloud JobFlow" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label x:Name="SupabaseStateLabel" Grid.Column="1" Text="Not connected" FontSize="12" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Sign in or create your JobFlow account to load the cloud feed. Your session is stored in Android Secure Storage; row-level security limits database access to your account." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Entry x:Name="SupabaseEmailEntry" Placeholder="Email address" Keyboard="Email" TextColor="{StaticResource Ink}" />
                    <Entry x:Name="SupabasePasswordEntry" Placeholder="Password (6+ characters)" IsPassword="True" TextColor="{StaticResource Ink}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Sign in" Clicked="OnSupabaseSignInClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                        <Button Grid.Column="1" Text="Create account" Clicked="OnSupabaseSignUpClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                    </Grid>
                    <Button x:Name="DisconnectSupabaseButton" Text="Sign out of Supabase" Clicked="OnSupabaseSignOutClicked" IsVisible="False" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />
                    <Label x:Name="SupabaseDetailsLabel" Text="Cloud sync is not connected." FontSize="12" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Label Text="GitHub · Job data" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label x:Name="GitHubStateLabel" Grid.Column="1" Text="Not connected" FontSize="12" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Uses GitHub Device Login (browser). The app stores only the access token and the repository you select. No client secret is embedded." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    </Grid>

                    <Label Text="GitHub sign-in is configured for this build. Tap below and approve the one-time device code in your browser." FontSize="12" TextColor="{StaticResource MutedInk}" />

                    <Button x:Name="SignInGitHubButton" Text="Sign in with GitHub" Clicked="OnSignInGitHubClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                    <Button x:Name="ChooseRepoButton" Text="Choose data repository" Clicked="OnChooseRepoClicked" IsVisible="False" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                    <Button x:Name="DisconnectGitHubButton" Text="Sign out of GitHub" Clicked="OnDisconnectGitHubClicked" IsVisible="False" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />

                    <Label x:Name="DeviceCodeLabel" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Accent}" IsVisible="False" HorizontalTextAlignment="Center" />
                    <Button x:Name="CopyDeviceCodeButton" Text="Copy activation code" Clicked="OnCopyDeviceCodeClicked" IsVisible="False" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                    <Label x:Name="GitHubDetailsLabel" Text="Not signed in on this device." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Label Text="After sign-in, JobFlow only reads the repository you pick. It does not submit applications or write to GitHub." FontSize="12" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Google Calendar" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label Grid.Column="1" Text="Not configured" FontSize="12" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Planned: official Google Android consent with calendar.readonly. JobFlow will never ask for your Google password and will not create or change events without an explicit confirmation." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Label Text="Next step: add an Android OAuth client ID in Google Cloud Console, enable the Calendar API, then wire the consent flow. Until then the Calendar tab is a layout placeholder." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Button Text="Open Calendar tab"
                            Clicked="OnOpenCalendarClicked"
                            BackgroundColor="#E9F0FF"
                            TextColor="{StaticResource Accent}"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Privacy: account sessions stay in Android Secure Storage on this device. Signing out removes the selected session locally." FontSize="12" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
