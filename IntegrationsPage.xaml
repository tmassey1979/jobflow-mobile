<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.IntegrationsPage"
             Title="Integrations"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                <Image Grid.Column="0" Source="signal_mark.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" VerticalOptions="Center" SemanticProperties.Description="JobFlow Signal Mark logo" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Cloud account" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Sign in to sync your jobs and application kits." FontSize="13" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Grid>
            <Border Stroke="#B9CBEA" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="JobFlow Cloud" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label x:Name="SupabaseStateLabel" Grid.Column="1" Text="Not connected" FontSize="12" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Create an account or sign in. Your session is stored in Android Secure Storage, and database access is restricted to your signed-in account." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Entry x:Name="SupabaseEmailEntry" Placeholder="Email address" Keyboard="Email" TextColor="{StaticResource Ink}" />
                    <Entry x:Name="SupabasePasswordEntry" Placeholder="Password (6+ characters)" IsPassword="True" TextColor="{StaticResource Ink}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Sign in" Clicked="OnSupabaseSignInClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                        <Button Grid.Column="1" Text="Create account" Clicked="OnSupabaseSignUpClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                    </Grid>
                    <Button x:Name="DisconnectSupabaseButton" Text="Sign out" Clicked="OnSupabaseSignOutClicked" IsVisible="False" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />
                    <Label x:Name="SupabaseDetailsLabel" Text="Cloud sync is not connected." FontSize="12" TextColor="{StaticResource MutedInk}" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Google Calendar" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                        <Label Grid.Column="1" Text="Not configured" FontSize="12" TextColor="{StaticResource MutedInk}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="Calendar integration is still a placeholder. JobFlow will not ask for your Google password or create/change events without explicit confirmation." FontSize="12" TextColor="{StaticResource MutedInk}" />
                    <Button Text="Open Calendar tab" Clicked="OnOpenCalendarClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>
            <Label Text="No GitHub account or repository connection is used by JobFlow." FontSize="12" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>