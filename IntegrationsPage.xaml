<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JobFlow.Mobile.IntegrationsPage"
             Title="Integrations"
             BackgroundColor="{StaticResource PageBackground}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="Connections" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
            <Label Text="Sign in once. JobFlow only reads the data repository you choose and never submits applications for you." FontSize="13" TextColor="{StaticResource MutedInk}" />

            <!-- GitHub -->
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="14" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="GitHub" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Ink}" />
                    <Label x:Name="GitHubStateLabel" Text="Not signed in" FontSize="13" TextColor="{StaticResource Accent}" />
                    <Label x:Name="GitHubDetailsLabel" FontSize="12" TextColor="{StaticResource MutedInk}" LineBreakMode="WordWrap" />
                    <Label x:Name="DeviceCodeLabel" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Ink}" IsVisible="False" HorizontalTextAlignment="Center" />
                    <Button x:Name="CopyDeviceCodeButton" Text="Copy code" Clicked="OnCopyDeviceCodeClicked" IsVisible="False" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="8" />
                    <Button x:Name="SignInGitHubButton" Text="Sign in with GitHub" Clicked="OnSignInGitHubClicked" BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="10" />
                    <Button x:Name="ChooseRepoButton" Text="Choose data repository" Clicked="OnChooseRepoClicked" IsVisible="False" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                    <Button x:Name="DisconnectGitHubButton" Text="Sign out of GitHub" Clicked="OnDisconnectGitHubClicked" IsVisible="False" BackgroundColor="#E9EDF4" TextColor="{StaticResource Ink}" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

            <!-- Google Calendar -->
            <Border Stroke="#D9E0EB" StrokeShape="RoundRectangle 14" Padding="14" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Google Calendar" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Ink}" />
                    <Label x:Name="CalendarStateLabel" Text="Not configured" FontSize="13" TextColor="{StaticResource Accent}" />
                    <Label x:Name="CalendarDetailsLabel"
                           Text="Read-only calendar access is planned so interview times can appear next to tracked applications. No events are created or modified without explicit confirmation."
                           FontSize="12" TextColor="{StaticResource MutedInk}" LineBreakMode="WordWrap" />
                    <Button x:Name="ConnectCalendarButton" Text="Connect Google Calendar" Clicked="OnConnectCalendarClicked" BackgroundColor="#E9F0FF" TextColor="{StaticResource Accent}" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

            <Label Text="JobFlow stores tokens only in Android Secure Storage on this device." FontSize="11" TextColor="{StaticResource MutedInk}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
